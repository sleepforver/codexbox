{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DevTools: Launch Electron",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "env": {
        "ELECTRON_RUN_AS_NODE": ""
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
